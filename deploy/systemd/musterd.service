[Unit]
Description=muster: GitHub Actions jobs in one-shot microVMs
Documentation=https://github.com/liquidmetal-dev/muster
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/muster/musterd.json

[Service]
Type=simple
ExecStart=/usr/bin/musterd -config /etc/muster/musterd.json
Restart=on-failure
RestartSec=5
# Above the 30s default shutdown_grace, so musterd ends its own drain.
TimeoutStopSec=60

User=muster
Group=muster
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# The Go runtime raises RLIMIT_NOFILE with setrlimit, which is in @resources.
# EPERM lets it carry on; the default action would kill musterd with SIGSYS.
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
